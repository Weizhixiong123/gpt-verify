# 服务器配置模板：cp env.production.example .env，然后填写下面标了「必填」的项

# ---- 镜像 ----
IMAGE=ghcr.io/weizhixiong123/gpt-verify:latest
# 宿主机端口，宝塔反向代理到 http://127.0.0.1:这个端口
HOST_PORT=3000

# ---- 服务 ----
BASE_PATH=/sms
PUBLIC_URL=https://gptsuchong.com/sms
TRUST_PROXY=1
# 必填：后台密码（https://gptsuchong.com/sms/admin），用 openssl rand -base64 24 生成
ADMIN_TOKEN=
# 取卡接口密钥：xianyu-auto-reply「API接口」卡券请求头填 {"Authorization": "Bearer 这个值"}；留空则接口关闭
# 用 openssl rand -hex 24 生成
CARD_API_KEY=
SUPPORT_CONTACT=请在闲鱼联系卖家
# 页面「联系客服」显示的微信号、QQ 号（留空不显示）
SUPPORT_WECHAT=
SUPPORT_QQ=
# 验证成功页推荐 Plus 充值：加客服微信立减的金额（元），留空则不显示
PROMO_PLUS_DISCOUNT=

# ---- 5SIM ----
# 必填：5SIM 后台 → 个人资料 → API 密钥（5SIM protocol）
FIVESIM_TOKEN=
FIVESIM_MOCK=0

# ---- 线路选择 ----
PRICE_CAP=0.2
PRICE_CAP_RETRY=0.5
ESCALATE_AFTER=2
EXCLUDE_COUNTRIES=
MIN_STOCK=50
BREAKER_FAILS=3
BREAKER_PAUSE_MIN=60

# ---- 换号规则 ----
MAX_SWAPS=5
SWAP_COOLDOWN_SEC=120
POLL_INTERVAL_MS=2000
