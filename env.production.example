# 服务器配置模板：cp env.production.example .env，然后填写下面标了「必填」的项

# ---- 镜像 ----
IMAGE=ghcr.io/weizhixiong123/gpt-verify:latest
# 宿主机端口，宝塔反向代理到 http://127.0.0.1:这个端口
HOST_PORT=3000

# ---- 服务 ----
BASE_PATH=/sms
PUBLIC_URL=https://gptsuchong.com/sms
TRUST_PROXY=1
# 必填：后台密码（https://gptsuchong.com/sms/admin），用 openssl rand -base64 24 生成
ADMIN_TOKEN=
# 取卡接口密钥：xianyu-auto-reply「API接口」卡券请求头填 {"Authorization": "Bearer 这个值"}；留空则接口关闭
# 用 openssl rand -hex 24 生成
CARD_API_KEY=
SUPPORT_CONTACT=请在闲鱼联系卖家
# 页面「联系客服」显示的微信号、QQ 号（留空不显示）
SUPPORT_WECHAT=
SUPPORT_QQ=
# 验证成功页推荐 Plus 充值：首月价格（元），例如 130；留空则不显示
PROMO_PLUS_PRICE=

# ---- 闲管家货源接口（API 发货）----
# 闲管家里配置的接口根地址（baseUrl）：PUBLIC_URL + /xgj，例如 https://gptsuchong.com/sms/xgj
# XGJ_APP_ID / XGJ_APP_SECRET：在闲管家注册货源应用后获得；XGJ_MCH_ID / XGJ_MCH_SECRET：我们给自己的商户号和密钥（自己定，填到闲管家里）
# 四项都填了才开启
XGJ_APP_ID=
XGJ_APP_SECRET=
XGJ_MCH_ID=
XGJ_MCH_SECRET=
XGJ_GOODS_NO=GPT-SMS
XGJ_GOODS_NAME=ChatGPT 手机号验证码
# 货源成本价（分），自己给自己供货填 0
XGJ_GOODS_PRICE=0
# 闲管家调用方 IP 白名单，逗号分隔，留空不限制
XGJ_IP_WHITELIST=

# ---- 5SIM ----
# 必填：5SIM 后台 → 个人资料 → API 密钥（5SIM protocol）
FIVESIM_TOKEN=
FIVESIM_MOCK=0

# ---- 线路选择 ----
PRICE_CAP=0.35
PRICE_CAP_RETRY=0.5
ESCALATE_AFTER=2
EXCLUDE_COUNTRIES=
MIN_STOCK=50
BREAKER_FAILS=3
BREAKER_PAUSE_MIN=15
# 号码被拒后换号：number = 只拉黑这个号码，继续用成功率最高的线路；country = 跳过整个国家
REJECT_SKIP=number

# ---- 换号规则 ----
MAX_SWAPS=5
SWAP_COOLDOWN_SEC=120
POLL_INTERVAL_MS=2000
