# 本地开发配置：cp .env.example .env 后 npm start。服务器部署用 env.production.example
# ---- 服务 ----
PORT=3000
HOST=127.0.0.1
# 页面挂载路径：https://gptsuchong.com/sms
BASE_PATH=/sms
# 对外完整地址，用于导出带链接的 CDK
PUBLIC_URL=https://gptsuchong.com/sms
# 部署在 nginx 后面时设为 1，用 X-Forwarded-For 识别用户 IP
TRUST_PROXY=1
# 管理后台密码（https://gptsuchong.com/sms/admin），务必改成长随机串
ADMIN_TOKEN=admin
# 取卡接口密钥：xianyu-auto-reply「API接口」卡券请求头填 {"Authorization": "Bearer 这个值"}；留空则接口关闭
# 用 openssl rand -hex 24 生成
CARD_API_KEY=
# 页面上显示的客服联系方式
SUPPORT_CONTACT=请在闲鱼联系卖家
# 页面「联系客服」显示的微信号、QQ 号（留空不显示）
SUPPORT_WECHAT=
SUPPORT_QQ=
# 验证成功页推荐 Plus 充值：首月价格（元），例如 130；留空则不显示
PROMO_PLUS_PRICE=

# ---- 闲管家货源接口（API 发货）----
# 闲管家里配置的接口根地址（baseUrl）：PUBLIC_URL + /xgj，例如 https://gptsuchong.com/sms/xgj
# XGJ_APP_ID / XGJ_APP_SECRET：在闲管家注册货源应用后获得；XGJ_MCH_ID / XGJ_MCH_SECRET：我们给自己的商户号和密钥（自己定，填到闲管家里）
# 四项都填了才开启
XGJ_APP_ID=
XGJ_APP_SECRET=
XGJ_MCH_ID=
XGJ_MCH_SECRET=
XGJ_GOODS_NO=GPT-SMS
XGJ_GOODS_NAME=ChatGPT 手机号验证码
# 货源成本价（分），自己给自己供货填 0
XGJ_GOODS_PRICE=0
# 闲管家调用方 IP 白名单，逗号分隔，留空不限制
XGJ_IP_WHITELIST=

# ---- 5SIM ----
# 5SIM 后台 → 个人资料 → API 密钥（5SIM protocol）
FIVESIM_TOKEN=
# 本地测试用：1 = 不调真实 5SIM，模拟买号/收码
FIVESIM_MOCK=0

# ---- 线路选择（按实时成功率自动排序，每 10 分钟刷新）----
# 第 1~ESCALATE_AFTER 次取号的单价上限（推荐 0.35：成功率高的线路基本都在这个价位内）
PRICE_CAP=0.35
# 默认分配策略：success=原成功率逻辑，recommended=网站国家顺序；后台保存的选择优先生效
ROUTING_MODE=success
# 网站排名模式的数据源
COUNTRY_ORDER_URL=https://sms.fur.li/api/compare?mode=recommended&country=&provider=&status=&sort=price_asc&summary=1
# 用户试错超过 ESCALATE_AFTER 次后，放宽到这个单价上限，换更贵但更容易收到码的线路
PRICE_CAP_RETRY=0.5
ESCALATE_AFTER=2
# 不想用的国家（5SIM 英文名），逗号分隔，例如 usa,india
EXCLUDE_COUNTRIES=
# 库存低于这个数的线路不用
MIN_STOCK=50
# 同一线路 1 小时内连续失败几单就暂停，暂停多少分钟
BREAKER_FAILS=3
BREAKER_PAUSE_MIN=15
# 号码被拒后自动优先换国家，其次换运营商；当前 CDK 不再使用已被拒的线路。

# ---- 规则 ----
# 每个 CDK 最多换号次数（不含第一次取号）
MAX_SWAPS=10
# 取号后多少秒才能点「没收到验证码，换号」
SWAP_COOLDOWN_SEC=120
# 后端查询 5SIM 的间隔（毫秒）
POLL_INTERVAL_MS=2000
